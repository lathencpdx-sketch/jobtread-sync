{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "composio": {
      "type": "http",
      "url": "https://connect.composio.dev/mcp"
    },
    "zenrows": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@zenrows/mcp"
      ],
      "env": {
        "ZENROWS_API_KEY": "${ZENROWS_API_KEY}"
      }
    }
  }
}